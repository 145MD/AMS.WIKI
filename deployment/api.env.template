# /etc/ams/api.env — Production secrets for AMS API
# Copy this file to /etc/ams/api.env on the VPS and fill in the values.
# chmod 600 /etc/ams/api.env && chown deploy:deploy /etc/ams/api.env
#
# ASP.NET Core reads env vars using __ (double underscore) as the section separator.
# e.g. "Jwt:SecretKey" in appsettings.json → "Jwt__SecretKey" here
# This mirrors what you have in local User Secrets (secrets.json).

# --- Database ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ams_prod;Username=ams_user;Password=CHANGE_ME

# --- JWT ---
Jwt__SecretKey=CHANGE_ME_min_32_chars

# --- MediatR license ---
MediatR__LicenseKey=CHANGE_ME

# --- Azure Blob Storage ---
ConnectionStrings__AzureBlobStorage=DefaultEndpointsProtocol=https;AccountName=CHANGE_ME;AccountKey=CHANGE_ME;EndpointSuffix=core.windows.net
ClientConnectionStrings__BlobConnectionString=CHANGE_ME
ClientConnectionStrings__AccountName=CHANGE_ME
ClientConnectionStrings__AccountKey=CHANGE_ME

# --- Azure AD / Google Auth ---
AzureAd__ClientSecret=CHANGE_ME
GoogleAuth__ClientId=CHANGE_ME
GoogleAuth__ClientSecret=CHANGE_ME

# --- Email ---
Email__SmtpUsername=CHANGE_ME
Email__SmtpPassword=CHANGE_ME

# --- Azure Service Bus (if used) ---
AzureServiceBus__ConnectionString=CHANGE_ME
