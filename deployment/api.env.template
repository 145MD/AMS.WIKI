# /etc/ams/api.env — Production secrets for AMS API
# Copy this file to /etc/ams/api.env on the VPS and fill in the values.
# chmod 600 /etc/ams/api.env && chown deploy:deploy /etc/ams/api.env
#
# ASP.NET Core reads env vars using __ (double underscore) as the section separator.
# e.g. "Jwt:SecretKey" in appsettings.json → "Jwt__SecretKey" here
# This mirrors what you have in local User Secrets (secrets.json).

# --- Database ---
# The DB is remote (Hostinger), so the connection crosses the network: TLS is
# mandatory (SEC-02). `Ssl Mode=Require` refuses an unencrypted fallback. For the
# strongest posture switch to `Ssl Mode=VerifyFull` and point `Root Certificate`
# at Hostinger's CA bundle instead of trusting the server cert blindly.
# Also restrict the DB user to this server's IP in Hostinger's remote-access panel.
ConnectionStrings__DefaultConnection=Host=CHANGE_ME_DB_HOST;Port=5432;Database=ams_prod;Username=ams_user;Password=CHANGE_ME;Ssl Mode=Require;Trust Server Certificate=true

# --- JWT ---
Jwt__SecretKey=CHANGE_ME_min_32_chars

# --- MediatR license ---
MediatR__LicenseKey=CHANGE_ME

# --- Azure Blob Storage ---
ConnectionStrings__AzureBlobStorage=DefaultEndpointsProtocol=https;AccountName=CHANGE_ME;AccountKey=CHANGE_ME;EndpointSuffix=core.windows.net
ClientConnectionStrings__BlobConnectionString=CHANGE_ME
ClientConnectionStrings__AccountName=CHANGE_ME
ClientConnectionStrings__AccountKey=CHANGE_ME

# --- Azure AD / Google Auth ---
AzureAd__ClientSecret=CHANGE_ME
GoogleAuth__ClientId=CHANGE_ME
GoogleAuth__ClientSecret=CHANGE_ME

# --- Email ---
# Public host of the admin/PWA that serves /reset-password. This is what goes into the
# reset-password link — set it to the domain, NOT the server IP.
Email__BaseUrl=https://portal.classpass.lk
# Active email provider is chosen at runtime in the admin panel. Fill the one(s) you use:
Resend__ApiKey=CHANGE_ME
TurboSmtp__ConsumerKey=CHANGE_ME
TurboSmtp__ConsumerSecret=CHANGE_ME

# Shared secret required on inbound delivery-receipt webhooks (SEC-07). The
# endpoint now FAILS CLOSED outside Development, so this MUST be set in production
# and mirrored in each provider's webhook config (X-Webhook-Secret header).
Notifications__WebhookSecret=CHANGE_ME

# --- Azure Service Bus (if used) ---
AzureServiceBus__ConnectionString=CHANGE_ME

# --- Multi-tenant subdomain config ---
# Apex domain under which tenants live. Tenant URLs become <slug>.<RootHostSuffix>.
# AdminSubdomain is the dedicated system-admin root (portal.classpass.lk).
Tenant__RootHostSuffix=classpass.lk
Tenant__AdminSubdomain=portal
